{
  "name": "caldav-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted iCloud CalDAV calendar broker exposed as an MCP server",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm typecheck:test && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
